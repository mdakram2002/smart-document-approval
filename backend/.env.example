DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_document_approval?schema=public"
JWT_ACCESS_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-random-secret-at-least-32-characters"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# Required only when running the non-destructive admin seed:
SEED_ADMIN_EMAIL="admin@example.test"
SEED_ADMIN_NAME="Local Administrator"
SEED_ADMIN_PASSWORD="replace-with-a-unique-password-of-12-or-more-characters"
